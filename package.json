{
  "name": "profile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "supabase:login": "supabase login",
    "supabase:start": "supabase start",
    "supabase:db:push": "supabase db push",
    "supabase:create-bucket": "bash ./scripts/create_supabase_bucket.sh",
    "db:init": "npm run supabase:db:push",
    "db:migrate:sql": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f ./supabase/migrations/001_create_tables.sql -f ./supabase/migrations/002_create_files.sql -f ./supabase/migrations/004_secure_workspace.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f ./supabase/seeds/001_insert_seed_data.sql",
    "test": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.1.2",
    "@mui/material": "^7.1.2",
    "@supabase/supabase-js": "^2.50.1",
    "matter-js": "^0.20.0",
    "pdfjs-dist": "^5.3.31",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.63.0",
    "@types/matter-js": "^0.20.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0"
  }
}
